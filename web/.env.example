# ==============================================================================
# Research Opportunity Radar — Next.js Web Dashboard Configuration
# ==============================================================================
# Copy this file to web/.env.local for local frontend dashboard execution.
# In production every variable marked REQUIRED must be set: auth fails closed (401/503)
# rather than falling back to an anonymous operator identity when they are missing.

# ------------------------------------------------------------------------------
# 1. Supabase
# ------------------------------------------------------------------------------
# REQUIRED. Server-side URL + keys for route handlers.
SUPABASE_URL=https://your-project.supabase.co
# REQUIRED. Used for user-scoped queries so Row Level Security applies. Without it, user requests
# fall back to the service key plus the user's JWT, and token-less calls are refused.
SUPABASE_ANON_KEY=eyJh...your-anon-public-key
# REQUIRED. Privileged key for operator/pipeline routes only (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-secret-key

# REQUIRED. Browser auth (cookie session). Safe to expose: the anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your-anon-public-key

# Local development only: acknowledge an unconfigured database without error banners
ALLOW_IN_MEMORY_DB=0

# ------------------------------------------------------------------------------
# 2. Operator access & remote pipeline dispatch
# ------------------------------------------------------------------------------
# Shared secret for CI/cron callers (Bearer token or x-radar-secret header). Grants operator role.
RADAR_API_SECRET=

# GitHub PAT with actions:write, used by /api/pipeline/trigger to dispatch pipeline.yml
GITHUB_PAT=
GITHUB_REPO=owner/research-opportunity-radar

# ------------------------------------------------------------------------------
# 3. AI Research Copilot (optional; falls back to the offline heuristic engine)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Model ids are configurable so a provider retiring a model is a config change, not a deploy
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Telegram alerts ("Settings -> Connect Telegram")
# ------------------------------------------------------------------------------
# Bot token from @BotFather. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (printed by: python scripts/telegram_setup.py --check)
TELEGRAM_BOT_USERNAME=
# Random 16-256 chars of A-Z a-z 0-9 _ - ; Telegram sends it with every webhook call
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Shared rate limiting (recommended in production)
# ------------------------------------------------------------------------------
# Without these, limits are per process and reset on every deploy/restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
