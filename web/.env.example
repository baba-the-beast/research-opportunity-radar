# ==============================================================================
# Research Opportunity Radar — Next.js Web Dashboard Configuration
# ==============================================================================
# Copy this file to web/.env.local for local frontend dashboard execution.

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# REQUIRED for Next.js Route Handlers reading/writing opportunities.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-secret-key

# Set to 1 to acknowledge unconfigured database without continuous error banners
ALLOW_IN_MEMORY_DB=0

# ------------------------------------------------------------------------------
# 2. Remote Pipeline Dispatch Integration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo/actions dispatch permissions
GITHUB_PAT=

# Target repository identifier in owner/repo format
GITHUB_REPO=owner/research-opportunity-radar
