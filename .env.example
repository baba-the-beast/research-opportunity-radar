# ==============================================================================
# Research Opportunity Radar — Root Environment Configuration
# ==============================================================================
# Copy this file to .env at the root for Python pipeline execution.
# For web dashboard execution, also copy to web/.env.local.

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# REQUIRED unless ALLOW_IN_MEMORY_DB=1 is set.
# Supabase project URL (format: https://<project-ref>.supabase.co)
# Obtain from: Supabase Console -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (admin key bypassing Row Level Security)
# Obtain from: Supabase Console -> Project Settings -> API -> Project API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-secret-key

# Set to 1 to explicitly enable ephemeral in-memory storage for dry-runs & tests without Supabase.
# In production, leave as 0 to fail loudly if credentials are missing.
ALLOW_IN_MEMORY_DB=0

# ------------------------------------------------------------------------------
# 2. Academic Intelligence Sources
# ------------------------------------------------------------------------------
# REQUIRED for pipeline paper discovery and venue monitoring.
# OpenAlex API key or polite-pool contact email address.
# Obtain from: https://openalex.org (free registration gives high throughput)
OPENALEX_API_KEY=faculty.radar@institution.edu

# Polite-pool contact email for Crossref API lookups
CROSSREF_MAILTO=faculty.radar@institution.edu

# Semantic Scholar API Key (optional, for citation graph lookups and embeddings)
# Obtain from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 3. Autonomous Notification Dispatch
# ------------------------------------------------------------------------------
# Telegram Bot API Token for real-time opportunity alerts
# Obtain from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Chat or Channel ID receiving immediate alerts
TELEGRAM_CHAT_ID=

# Brevo (Sendinblue) API Key for automated weekly executive digests
# Obtain from: Brevo Dashboard -> SMTP & API
BREVO_API_KEY=

# Verified sender email address configured in Brevo
BREVO_SENDER_EMAIL=radar@institution.edu

# Faculty recipient email address for weekly opportunity digests
BREVO_RECIPIENT_EMAIL=faculty@institution.edu

# ------------------------------------------------------------------------------
# 4. Pipeline Tunables & Scoring Thresholds
# ------------------------------------------------------------------------------
# Minimum score tier to trigger notification ('immediate', 'digest', 'watch')
MIN_RELEVANCE_BAND=watch

# Urgent temporal horizon: opportunities with deadlines within this number of days
DEADLINE_ALERT_WINDOW_DAYS=30

# ------------------------------------------------------------------------------
# 5. Remote Pipeline Dispatch & GitHub Actions
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo/workflow dispatch scopes
GITHUB_PAT=

# Target GitHub repository in owner/repo format for remote pipeline triggers
GITHUB_REPO=owner/research-opportunity-radar

# ------------------------------------------------------------------------------
# 6. Web Dashboard Security & Mutex Protection
# ------------------------------------------------------------------------------
# Shared secret protecting mutating endpoints (/api/pipeline/stream?run=true, /api/profile, etc.)
# If unset, the dashboard operates in trusted single-user intranet mode.
RADAR_API_SECRET=
# Matching client-side public secret required for browser-triggered pipeline rescans
NEXT_PUBLIC_RADAR_API_SECRET=

