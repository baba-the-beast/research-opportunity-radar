# ==============================================================================
# Research Opportunity Radar — Root Environment Configuration
# ==============================================================================
# Copy this file to .env at the root for Python pipeline execution.
# For web dashboard execution, also copy to web/.env.local.

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# REQUIRED unless ALLOW_IN_MEMORY_DB=1 is set.
# Supabase project URL (format: https://<project-ref>.supabase.co)
# Obtain from: Supabase Console -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (admin key bypassing Row Level Security)
# Obtain from: Supabase Console -> Project Settings -> API -> Project API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-secret-key

# Web dashboard (same container on Render): user-scoped queries run with the anon key + the user's
# JWT so Row Level Security applies. See web/.env.example for the full web configuration.
SUPABASE_ANON_KEY=eyJh...your-anon-public-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your-anon-public-key

# Set to 1 to explicitly enable ephemeral in-memory storage for dry-runs & tests without Supabase.
# In production, leave as 0 to fail loudly if credentials are missing.
ALLOW_IN_MEMORY_DB=0

# ------------------------------------------------------------------------------
# 2. Opportunity sources
# ------------------------------------------------------------------------------
# No keys are needed for the Indian agency sources (ANRF, DST, DBT, ICMR) or WikiCFP.
# Your email puts OpenAlex/Crossref requests in the "polite pool" (used by the MCP literature tool).
CROSSREF_MAILTO=you@institution.edu
# Optional. OpenAlex key (or email); falls back to CROSSREF_MAILTO.
OPENALEX_API_KEY=
# Optional. Semantic Scholar API key (higher rate limit for the MCP literature tool)
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 3. Autonomous Notification Dispatch
# ------------------------------------------------------------------------------
# Telegram Bot API Token for real-time opportunity alerts
# Obtain from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Web server also needs TELEGRAM_BOT_USERNAME and TELEGRAM_WEBHOOK_SECRET for per-user
# "Connect Telegram" (see web/.env.example and README -> Telegram Alerts).

# Operator chat for pipeline-failure alerts (users connect their own chats in Settings)
TELEGRAM_CHAT_ID=

# Brevo (Sendinblue) API key for email digests and deadline alerts (optional)
# Obtain from: Brevo Dashboard -> SMTP & API
BREVO_API_KEY=

# Verified sender email address configured in Brevo
BREVO_SENDER_EMAIL=radar@institution.edu

# Legacy single-recipient address (per-user alerts go to each user's sign-in email)
BREVO_RECIPIENT_EMAIL=faculty@institution.edu

# ------------------------------------------------------------------------------
# 4. Pipeline tunables
# ------------------------------------------------------------------------------
# Relevance bands and alert windows are per user (Profile page); these are legacy defaults.
MIN_RELEVANCE_BAND=watch
DEADLINE_ALERT_WINDOW_DAYS=30

# ------------------------------------------------------------------------------
# 5. Remote Pipeline Dispatch & GitHub Actions
# ------------------------------------------------------------------------------
# Fine-grained GitHub token with "Actions: write" on this repository (for the "Scan now" button)
GITHUB_PAT=

# Target GitHub repository in owner/repo format for remote pipeline triggers
GITHUB_REPO=owner/research-opportunity-radar

# ------------------------------------------------------------------------------
# 6. External Webhook & Trigger Security
# ------------------------------------------------------------------------------
# Server-side shared secret protecting external trigger endpoints (e.g. /api/pipeline/trigger)
# invoked by external systems like GitHub Actions or cron jobs.
# Browser-originated requests rely on per-IP rate limiting and input validation.
RADAR_API_SECRET=

